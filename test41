getgenv().__HubCleanup = function()
    Running = false
    Config.AutoFarm, Config.BringMobs, Config.AutoQuest, Config.FastAttack = false, false, false, false
    CancelTween(); NoclipOn = false; setHover(false)
    for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
    if Gui then Gui:Destroy() end
    getgenv().__HubCleanup = nil
end
