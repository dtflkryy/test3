        Text = text, TextColor3 = THEME.Text, Font = Enum.Font.Gotham, TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = btn,
    })
    local pill = new("Frame", { Size = UDim2.fromOffset(40, 22), Position = UDim2.new(1, -52, 0.5, -11),
        BackgroundColor3 = THEME.Off, Parent = btn }, { corner(11) })
    local knob = new("Frame", { Size = UDim2.fromOffset(18, 18), Position = UDim2.fromOffset(2, 2),
        BackgroundColor3 = THEME.Text, Parent = pill }, { corner(9) })
