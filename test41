local function track(conn) table.insert(Connections, conn); return conn end

--// UTILS
local function getChar()  return LocalPlayer.Character end
local function getRoot()
    local c = getChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function getHum()
    local c = getChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function isAlive(model)
    local h = model and model:FindFirstChildOfClass("Humanoid")
    return h ~= nil and h.Health > 0 and model:FindFirstChild("HumanoidRootPart") ~= nil
end

--// NOCLIP + HOVER (chỉ chạy khi cần, tránh tốn tài nguyên)
local NoclipOn = false
track(RunService.Stepped:Connect(function()
    if not NoclipOn then return end
    local c = getChar()
    if not c then return end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
    end
end))

local function setHover(on)
    local root = getRoot()
    if not root then return end
    local bv = root:FindFirstChild("HubHover")
    if on and not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name, bv.MaxForce, bv.Velocity = "HubHover", Vector3.new(1e5, 1e5, 1e5), Vector3.zero
        bv.Parent = root
    elseif not on and bv then
        bv:Destroy()
    end
end

local function setFarmingMode(on)
    NoclipOn = on
    setHover(on)
end

--// TWEEN
local function CancelTween()
    if CurrentTween then CurrentTween:Cancel(); CurrentTween = nil end
end

local function TweenTo(targetCF, speed)
    local root = getRoot()
    if not root then return false end
    speed = speed or Config.TweenSpeed
    local dist = (root.Position - targetCF.Position).Magnitude
    if dist < 4 then root.CFrame = targetCF return true end

    CancelTween()
    NoclipOn = true
    setHover(true)
    local tween = TweenService:Create(root, TweenInfo.new(dist / speed, Enum.EasingStyle.Linear), { CFrame = targetCF })
    CurrentTween = tween
    tween:Play()
    local state = tween.Completed:Wait() -- trả về cả khi bị Cancel
    if CurrentTween == tween then CurrentTween = nil end
    return state == Enum.PlaybackState.Completed
end

--// QUEST LOOKUP
local function getQuestForLevel()
    local lvl, list = PH.GetLevel(), QuestData[State.Sea]
    if not list then return nil end
    local best
    for _, q in ipairs(list) do
        if lvl >= q.MinLevel and lvl <= q.MaxLevel then return q end
        if lvl >= q.MinLevel then best = q end -- fallback: quest gần nhất dưới level
    end
    return best
end

--// MOBS
local function getMobs(name, range, origin)
    local folder, result = PH.EnemiesFolder(), {}
    if not folder then return result end
    for _, m in ipairs(folder:GetChildren()) do
        if m.Name == name and isAlive(m) then
            local d = (m.HumanoidRootPart.Position - origin).Magnitude
            if d <= range then table.insert(result, { mob = m, dist = d }) end
        end
    end
    table.sort(result, function(a, b) return a.dist < b.dist end)
    return result
end

local function BringMobs(mobName)
    local root = getRoot()
    if not root or not State.Target then return end
    -- điểm gom: ngay dưới chân nhân vật để quái nằm trong tầm đánh
    local point = root.CFrame * CFrame.new(0, -Config.FarmHeight + 2, -4)
    pcall(function() sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge) end)

    local list = getMobs(mobName, Config.BringRange, root.Position)
    for i = 1, math.min(#list, Config.BringLimit) do
        local m = list[i].mob
        local hrp = m.HumanoidRootPart
        hrp.CanCollide = false
        hrp.Velocity = Vector3.zero
        hrp.CFrame = point
    end
end

--// COMBAT
local function equipTool()
    local char, hum = getChar(), getHum()
    if not (char and hum) then return nil end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then return tool end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    tool = bp and bp:FindFirstChildOfClass("Tool")
    if tool then hum:EquipTool(tool) end
    return tool
end

local function Attack()
    local tool = equipTool()
    if not tool then return end
    local remote = PH.AttackRemote()
    if remote then
        pcall(function() remote:FireServer(0.4) end) -- [PLACEHOLDER] tham số tấn công
    end
    pcall(function() tool:Activate() end)
end

--// AUTO FARM STEP
local function farmStep()
    local quest = getQuestForLevel()
    if not quest then State.Target = nil return end

    -- 1. Nhận quest
    if Config.AutoQuest and not PH.IsQuestActive() then
        State.Target = nil
        if TweenTo(quest.NPC) and Config.AutoFarm then
            local remote = PH.CommRemote()
            if remote then pcall(PH.StartQuest, remote, quest) end
            task.wait(0.5)
        end
        return
    end

    -- 2. Tìm quái (ưu tiên gần nhất; nếu chưa có thì bay tới bãi quái)
    local root = getRoot()
    if not root then return end
    local mobs = getMobs(quest.MobName, 2000, root.Position)
    if #mobs == 0 then
        State.Target = nil
        TweenTo(quest.MobArea * CFrame.new(0, Config.FarmHeight, 0))
        task.wait(0.5) -- chờ respawn quái
        return
    end

    -- 3. Bay lên đầu quái, nhìn xuống, giữ vị trí tới khi quái chết
    local mob = mobs[1].mob
    State.Target = mob
    while Config.AutoFarm and isAlive(mob) and State.Alive do
        local hrp = mob:FindFirstChild("HumanoidRootPart")
        local r = getRoot()
        if not (hrp and r) then break end
        if (r.Position - hrp.Position).Magnitude > 60 then
            TweenTo(hrp.CFrame * CFrame.new(0, Config.FarmHeight, 0))
        else
            r.CFrame = CFrame.new(hrp.Position + Vector3.new(0, Config.FarmHeight, 0), hrp.Position)
        end
        if Config.AutoQuest and not PH.IsQuestActive() then break end -- quest xong → nhận lại
        task.wait()
    end
    State.Target = nil
end

--// BACKGROUND LOOPS (task.spawn, mỗi vòng tự ngủ khi tắt)
local Running = true

task.spawn(function() -- AutoFarm
    while Running do
        if Config.AutoFarm and State.Alive and getRoot() then
            local ok, err = pcall(farmStep)
            if not ok then warn("[Hub] AutoFarm:", err); task.wait(1) end
        else
            if NoclipOn or CurrentTween then
                CancelTween(); setFarmingMode(false); State.Target = nil
            end
            task.wait(0.3)
        end
        task.wait()
    end
end)

task.spawn(function() -- BringMobs
    while Running do
        if Config.BringMobs and Config.AutoFarm and State.Target then
            local q = getQuestForLevel()
            if q then pcall(BringMobs, q.MobName) end
            task.wait(0.15)
        else
            task.wait(0.4)
        end
    end
end)

task.spawn(function() -- FastAttack
    while Running do
        local t = State.Target
        local root = getRoot()
        if Config.AutoFarm and t and isAlive(t) and root
            and (root.Position - t.HumanoidRootPart.Position).Magnitude <= 70 then
            pcall(Attack)
            task.wait(Config.FastAttack and 0.05 or 0.35)
        else
            task.wait(0.2)
        end
    end
end)

--// CHARACTER EVENTS
local function onCharacter(char)
    State.Alive = true
    local hum = char:WaitForChild("Humanoid", 10)
    if hum then
        track(hum.Died:Connect(function()
            State.Alive = false; State.Target = nil
            CancelTween(); NoclipOn = false
        end))
    end
    char:WaitForChild("HumanoidRootPart", 10)
    State.Alive = true
end
track(LocalPlayer.CharacterAdded:Connect(onCharacter))
if LocalPlayer.Character then task.spawn(onCharacter, LocalPlayer.Character) end

