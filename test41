local Pages, TabButtons = {}, {}
local function createPage(name)
    local page = new("ScrollingFrame", {
        Size = UDim2.new(1, -16, 1, -84), Position = UDim2.fromOffset(8, 76), BackgroundTransparency = 1,
        BorderSizePixel = 0, ScrollBarThickness = 3, AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(), Visible = false, Parent = Main,
    }, { new("UIListLayout", { Padding = UDim.new(0, 6) }) })
    Pages[name] = page

    local btn = new("TextButton", {
        Size = UDim2.new(0, 88, 1, 0), BackgroundColor3 = THEME.Off, Text = name,
        TextColor3 = THEME.Text, Font = Enum.Font.GothamMedium, TextSize = 13, Parent = TabBar,
    }, { corner(8) })
    TabButtons[name] = btn
    btn.Activated:Connect(function()
        for n, p in pairs(Pages) do
            p.Visible = (n == name)
            TabButtons[n].BackgroundColor3 = (n == name) and THEME.Accent or THEME.Off
        end
    end)
    return page
end

