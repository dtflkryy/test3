local function switch(parent, get, set)
	local track = make("TextButton", {
		Size = UDim2.fromOffset(46, 24), AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0), Text = "", AutoButtonColor = false,
		BackgroundColor3 = C.card2,
	}, parent)
	corner(track, 12)
	local knob = make("Frame", {
		Size = UDim2.fromOffset(18, 18), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = WHITE,
	}, track)
	corner(knob, 9)
	local function update(animate)
		local on = get()
		local col = on and accent() or C.card2
		local pos = on and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3)
		if animate then
			tween(track, { BackgroundColor3 = col }, 0.2)
			tween(knob, { Position = pos }, 0.25, Enum.EasingStyle.Back)
		else
			track.BackgroundColor3 = col
			knob.Position = pos
		end
	end
	track.Activated:Connect(function() set(not get()); update(true) end)
	onTheme(function() update(false) end)
	return update
end

local function segment(parent, items, get, set, size, pos)
	local n = #items
	local holder = make("Frame", { Size = size, Position = pos, BackgroundColor3 = C.card2, BorderSizePixel = 0 }, parent)
	corner(holder, 8)
	local pill = make("Frame", {
		Size = UDim2.new(1 / n, -4, 1, -4), Position = UDim2.new(0, 2, 0, 2),
		BackgroundColor3 = accent(), BorderSizePixel = 0, ZIndex = 1,
	}, holder)
	corner(pill, 6)
	local btns = {}
	local function update(animate)
		local i = get()
		local target = UDim2.new((i - 1) / n, 2, 0, 2)
		if animate then tween(pill, { Position = target }, 0.25) else pill.Position = target end
		for k, b in ipairs(btns) do b.TextColor3 = (k == i) and WHITE or C.sub end
	end
	for i, it in ipairs(items) do
		local b = make("TextButton", {
			Size = UDim2.new(1 / n, 0, 1, 0), Position = UDim2.new((i - 1) / n, 0, 0, 0),
			BackgroundTransparency = 1, Text = it.raw or "", Font = FONTB, TextSize = 15,
			TextColor3 = C.sub, ZIndex = 2, AutoButtonColor = false,
		}, holder)
		fit(b, 15)
		if it.key then text(b, it.key) end
		b.Activated:Connect(function() set(i); update(true) end)
		btns[i] = b
	end
	onTheme(function() pill.BackgroundColor3 = accent(); update(false) end)
	return holder, update
end

local function fmt(n) return tostring(math.floor(n * 100 + 0.5) / 100) end

local function inputRow(parent, order, key, get, set, max, hintKey)
	local c = card(parent, 44, order)
	text(lbl(c, { Size = UDim2.new(1, -118, 1, 0), Position = UDim2.fromOffset(12, 0) }), key)
	local box = make("TextBox", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(92, 28), BackgroundColor3 = C.card2, Text = fmt(get()),
		TextColor3 = C.text, PlaceholderColor3 = C.sub, Font = FONT, TextSize = 16,
		ClearTextOnFocus = false,
	}, c)
	corner(box, 7)
	fit(box, 16)
	if hintKey then onLang(function() box.PlaceholderText = tr(hintKey) end) end
	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n then set(math.clamp(n, 0, max)); save() end
		box.Text = fmt(get())
	end)
end

local function stepper(parent, order, key, getText, dec, inc)
	local c = card(parent, 44, order)
	text(lbl(c, { Size = UDim2.new(1, -130, 1, 0), Position = UDim2.fromOffset(12, 0) }), key)
	local function mk(txt, x)
		local b = make("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, x, 0.5, 0),
			Size = UDim2.fromOffset(28, 28), BackgroundColor3 = C.card2, Text = txt,
			TextColor3 = C.text, Font = FONTB, TextSize = 20, AutoButtonColor = true,
		}, c)
		corner(b, 7)
		return b
	end
	local plus, minus = mk("+", -10), mk("-", -98)
	local val = lbl(c, {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -42, 0.5, 0),
		Size = UDim2.fromOffset(52, 28), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 16,
	})
	local function refresh() val.Text = getText() end
	plus.Activated:Connect(function() inc(); refresh(); save() end)
	minus.Activated:Connect(function() dec(); refresh(); save() end)
	refresh()
end

