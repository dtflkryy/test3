-- Hệ thống kéo thả mượt mà cho Mobile & PC (tôn trọng nút Khóa)
local dragging = false
local dragInput, dragStart, startPos

TopBar.InputBegan:Connect(function(input)
    if IsGuiLocked then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging and not IsGuiLocked then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

-- Vòng lặp kiểm tra Auto Tele & Auto Tele khi máu thấp
RunService.Heartbeat:Connect(function()
    local targetCFrame = SavedPoints[SelectedAutoPoint]
    if not targetCFrame then return end

    -- 1. Chế độ Auto Tele liên tục
    if AutoTeleEnabled then
        TeleportTo(targetCFrame)
        return
    end

    -- 2. Chế độ Auto Tele khi máu thấp
    if AutoLowHPEnabled then
        local char = LocalPlayer.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health > 0 and humanoid.MaxHealth > 0 then
            local hpPercent = (humanoid.Health / humanoid.MaxHealth) * 100
            local threshold = HPThresholds[CurrentThresholdIndex]
            if hpPercent < threshold then
                TeleportTo(targetCFrame)
            end
        end
    end
end)
