    TeleBtn.Size = UDim2.new(0.68, -4, 1, 0)
    TeleBtn.BackgroundColor3 = Color3.fromRGB(40, 44, 56)
    TeleBtn.Text = "Điểm " .. i .. " [Trống]"
    TeleBtn.TextColor3 = Color3.fromRGB(180, 185, 200)
    TeleBtn.Font = Enum.Font.GothamSemibold
    TeleBtn.TextSize = 12
    TeleBtn.Parent = Row
    Instance.new("UICorner", TeleBtn).CornerRadius = UDim.new(0, 5)

    -- Nút Set để lưu tọa độ hiện tại vào điểm i
    local SetBtn = Instance.new("TextButton")
    SetBtn.Size = UDim2.new(0.32, 0, 1, 0)
    SetBtn.Position = UDim2.new(0.68, 0, 0, 0)
    SetBtn.BackgroundColor3 = Color3.fromRGB(52, 105, 215)
    SetBtn.Text = "Set " .. i
    SetBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    SetBtn.Font = Enum.Font.GothamBold
    SetBtn.TextSize = 12
    SetBtn.Parent = Row
    Instance.new("UICorner", SetBtn).CornerRadius = UDim.new(0, 5)

    SetBtn.MouseButton1Click:Connect(function()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            SavedPoints[i] = hrp.CFrame
            TeleBtn.Text = "Điểm " .. i .. " [Đã lưu]"
            TeleBtn.TextColor3 = Color3.fromRGB(110, 235, 140)
            SetBtn.Text = "Đã lưu!"
            task.delay(0.7, function()
                if SetBtn then SetBtn.Text = "Set " .. i end
            end)
        end
    end)

    TeleBtn.MouseButton1Click:Connect(function()
        if SavedPoints[i] then
            TeleportTo(SavedPoints[i])
        end
    end)
end

