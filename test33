local function GetCharacter()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hum and hrp and hum.Health > 0 then return char, hum, hrp end
end

local function EquipWeapon(hum)
    if hum.Parent:FindFirstChildOfClass("Tool") then return end
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not bp then return end
    local tool = (Config.WeaponName ~= "" and bp:FindFirstChild(Config.WeaponName)) or bp:FindFirstChildOfClass("Tool")
    if tool then hum:EquipTool(tool) end
end

-- ----- Noclip (nhiều "chủ sở hữu": Farm / Tween / Manual) -----
local NoclipOwners, NoclipConn, NoclipOriginal = {}, nil, {}

local function SetNoclip(owner, state)
    NoclipOwners[owner] = state or nil
    local want = next(NoclipOwners) ~= nil
    if want and not NoclipConn then
        NoclipConn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            for _, p in ipairs(char:GetChildren()) do
                if p:IsA("BasePart") and p.CanCollide then
                    NoclipOriginal[p] = true -- nhớ để khôi phục chính xác
                    p.CanCollide = false
                end
            end
        end)
    elseif not want and NoclipConn then
        NoclipConn:Disconnect()
        NoclipConn = nil
        for p in pairs(NoclipOriginal) do
            if p.Parent then p.CanCollide = true end
        end
        table.clear(NoclipOriginal)
    end
end

-- ----- Hover: chống rơi khi đứng/tween giữa không trung -----
local function EnsureHover(hrp)
    if hrp:FindFirstChild("HubHover") then return end
    local bv = Instance.new("BodyVelocity")
    bv.Name = "HubHover"
    bv.Velocity = Vector3.zero
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Parent = hrp
end

local function RemoveHover()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local bv = hrp and hrp:FindFirstChild("HubHover")
    if bv then bv:Destroy() end
end

-- ----- TweenTo -----
local CurrentTween

local function CancelTween()
    if CurrentTween then CurrentTween:Cancel() CurrentTween = nil end
end

local function StopTween() -- dừng hẳn + dọn trạng thái
    CancelTween()
    SetNoclip("Tween", false)
    if not Config.AutoFarm then RemoveHover() end
end

-- Trả về true nếu tới đích. abortIf(): hàm tùy chọn, trả true để hủy giữa chừng.
local function TweenTo(targetCFrame, abortIf)
    local _, _, hrp = GetCharacter()
    if not hrp then return false end
    local dist = (hrp.Position - targetCFrame.Position).Magnitude
    if dist < 3 then hrp.CFrame = targetCFrame return true end

    CancelTween()
    SetNoclip("Tween", true)
    EnsureHover(hrp)

    local duration = dist / math.clamp(Config.TweenSpeed, 50, 500)
    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    local finalState
    tween.Completed:Once(function(state) finalState = state end)
    CurrentTween = tween
    tween:Play()

    local deadline = os.clock() + duration + 2 -- chống treo vĩnh viễn
    while finalState == nil do
        if Destroyed or (abortIf and abortIf()) or not GetCharacter() or os.clock() > deadline then
            tween:Cancel()
            break
        end
        task.wait()
    end

    -- Chỉ dọn nếu tween này vẫn là tween hiện hành (tránh phá tween mới thay thế nó)
    if CurrentTween == tween then
        CurrentTween = nil
        SetNoclip("Tween", false)
        if not Config.AutoFarm then RemoveHover() end
    end
    return finalState == Enum.PlaybackState.Completed
end

-- ===================== CORE: QUÁI =====================
-- Trả về danh sách {Model, Root, Humanoid, Dist} còn sống, sắp xếp gần -> xa.
local function GetMobs(mobName, origin, radius)
    local result = {}
    local folder = Hooks.GetEnemiesFolder()
    if not folder then return result end
    for _, mob in ipairs(folder:GetChildren()) do
        if not mobName or mob.Name == mobName then
            local root = mob:FindFirstChild("HumanoidRootPart")
            local hum = mob:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local d = (root.Position - origin).Magnitude
                if d <= radius then
                    table.insert(result, {Model = mob, Root = root, Humanoid = hum, Dist = d})
                end
            end
        end
    end
    table.sort(result, function(a, b) return a.Dist < b.Dist end)
    return result
end

local LastSimBoost = 0
local function BoostNetworkOwnership() -- cần executor hỗ trợ; lỗi thì bỏ qua
    if os.clock() - LastSimBoost < 5 then return end
    LastSimBoost = os.clock()
    pcall(function()
        if sethiddenproperty then sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge) end
        if setsimulationradius then setsimulationradius(math.huge, math.huge) end
    end)
end

-- Gom quái về điểm phía trước nhân vật.
local MAX_BRING = 25
local function BringMobs(mobs, point)
    BoostNetworkOwnership()
    for i = 1, math.min(#mobs, MAX_BRING) do
        local m = mobs[i]
        if (m.Root.Position - point).Magnitude > 4 then -- bỏ qua quái đã ở đúng chỗ
            m.Root.CFrame = CFrame.new(point)
            m.Root.AssemblyLinearVelocity = Vector3.zero
            m.Root.CanCollide = false
        end
    end
end

-- ===================== CORE: QUEST + FARM =====================
local ZONE_RADIUS = 150
local State = {Entry = nil, QuestFails = 0, QuestRetryAt = 0, Status = "Idle"}

local function GetQuestEntry()
    local list = QuestData[Hooks.GetSea()]
    if not list then return nil end
    local level, best = Hooks.GetLevel(), nil
    for _, e in ipairs(list) do
        if level >= e.MinLevel and (not best or e.MinLevel > best.MinLevel) then best = e end
    end
    return best or list[1] -- level thấp hơn mọi mốc -> dùng mốc đầu
end

local function AbortFarm() return Destroyed or not Config.AutoFarm end

local function FarmStep()
    local _, hum, hrp = GetCharacter()
    if not hrp then
        State.Status = "Đang chờ hồi sinh..."
        task.wait(1)
        return
    end
    local entry = GetQuestEntry()
    if not entry then State.Status = "Thiếu QuestData cho Sea này" task.wait(2) return end
    if State.Entry ~= entry then State.Entry = entry State.QuestFails = 0 end

    SetNoclip("Farm", true)
    EnsureHover(hrp)
    EquipWeapon(hum)

    -- 1) Nhận quest (tối đa 3 lần thất bại, nghỉ 30s rồi thử lại - không kẹt vòng lặp)
    local canTryQuest = State.QuestFails < 3 or os.clock() > State.QuestRetryAt
    if Config.AutoQuest and canTryQuest and not Hooks.HasActiveQuest(entry) then
        if State.QuestFails >= 3 then State.QuestFails = 0 end
        State.Status = "Đi nhận quest: " .. entry.QuestName
        if TweenTo(entry.NPCPos, AbortFarm) then
            Hooks.StartQuest(entry)
            task.wait(0.6)
            if Hooks.HasActiveQuest(entry) then
                State.QuestFails = 0
            else
                State.QuestFails += 1
                if State.QuestFails >= 3 then State.QuestRetryAt = os.clock() + 30 end
            end
        end
        return
    end

    -- 2) Về bãi quái nếu đang ở quá xa
    local anchor = entry.MobPos + Vector3.new(0, Config.FarmHeight, 0)
    if (hrp.Position - anchor.Position).Magnitude > ZONE_RADIUS then
        State.Status = "Di chuyển tới bãi quái"
        TweenTo(anchor, AbortFarm)
        return
    end

    -- 3) Farm
    local mobs = GetMobs(entry.MobName, hrp.Position, ZONE_RADIUS)
    local target = mobs[1]
    if Config.BringMobs then
        State.Status = ("Farm + gom quái (%d)"):format(#mobs)
        if (hrp.Position - anchor.Position).Magnitude > 4 then hrp.CFrame = anchor end -- đứng yên tại anchor
    elseif target then
        State.Status = "Farm: " .. entry.MobName
        local pos = CFrame.new(target.Root.Position + Vector3.new(0, Config.FarmHeight, 0))
        if (hrp.Position - pos.Position).Magnitude > 15 then
            TweenTo(pos, AbortFarm)
        else
            hrp.CFrame = pos
        end
    else
        State.Status = "Chờ quái hồi sinh"
        if (hrp.Position - anchor.Position).Magnitude > 4 then TweenTo(anchor, AbortFarm) end
    end

    if not Config.FastAttack then Hooks.BasicAttack() end
end

local function FarmCleanup()
    State.Entry = nil
    State.Status = "Idle"
    StopTween()
    SetNoclip("Farm", false)
    RemoveHover()
end

local function BringStep()
    local _, _, hrp = GetCharacter()
    if not hrp then return end
    local name = (Config.AutoFarm and State.Entry) and State.Entry.MobName or nil
    local yOff = Config.AutoFarm and -Config.FarmHeight or 0
    local point = hrp.Position + hrp.CFrame.LookVector * Config.BringForward + Vector3.new(0, yOff, 0)
    BringMobs(GetMobs(name, hrp.Position, Config.BringRadius), point)
end

local function AttackStep()
    local _, hum, hrp = GetCharacter()
    if not hrp then return end
    EquipWeapon(hum)
    local name = (Config.AutoFarm and State.Entry) and State.Entry.MobName or nil
    local mobs = GetMobs(name, hrp.Position, Config.AttackRange)
    if #mobs > 0 then Hooks.FastAttack(mobs) end
end

-- ===================== LOOP MANAGER (task.spawn) =====================
-- Mỗi loop chỉ chạy 1 bản duy nhất; tự thoát khi tắt Config hoặc Destroyed.
local Running = {}
local function StartLoop(name, flagKey, interval, step, onStop)
    if Running[name] then return end
    Running[name] = true
    task.spawn(function()
        while Config[flagKey] and not Destroyed do
            local ok, err = pcall(step)
            if not ok then
                warn(("[Hub] Lỗi loop %s: %s"):format(name, tostring(err)))
                task.wait(1)
            end
            task.wait(type(interval) == "function" and interval() or interval)
        end
        Running[name] = nil
        if onStop and not Destroyed then pcall(onStop) end
    end)
end

local Renderers, Handlers = {}, {}

Handlers.AutoFarm   = function(on) if on then StartLoop("Farm", "AutoFarm", 0.1, FarmStep, FarmCleanup) else StopTween() end end
Handlers.BringMobs  = function(on) if on then StartLoop("Bring", "BringMobs", 0.25, BringStep) end end
Handlers.FastAttack = function(on) if on then StartLoop("Attack", "FastAttack", function() return math.max(Config.AttackDelay, 0.05) end, AttackStep) end end
Handlers.Noclip     = function(on) SetNoclip("Manual", on) end

local function SetFeature(key, value)
    Config[key] = value
    if Renderers[key] then Renderers[key]() end
    if Handlers[key] then Handlers[key](value) end
end

