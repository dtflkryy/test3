-- ===================== [PLACEHOLDER] REMOTE =====================
-- Đường dẫn bắt đầu từ ReplicatedStorage. SỬA THEO GAME CỦA BẠN.
local RemotePaths = {
    Attack     = {"Remotes", "Attack"},      -- PLACEHOLDER: RemoteEvent đánh
    StartQuest = {"Remotes", "StartQuest"},  -- PLACEHOLDER: nhận quest
    TravelSea  = {"Remotes", "TravelSea"},   -- PLACEHOLDER: chuyển Sea (chưa dùng)
}
local RemoteCache, WarnedRemote = {}, {}

local function GetRemote(key)
    local cached = RemoteCache[key]
    if cached and cached.Parent then return cached end
    local node = ReplicatedStorage
    for _, name in ipairs(RemotePaths[key]) do
        node = node and node:FindFirstChild(name)
    end
    if node then RemoteCache[key] = node return node end
    if not WarnedRemote[key] then
        WarnedRemote[key] = true
        warn("[Hub] Chưa có remote placeholder: " .. key)
    end
    return nil
end

local function FireRemote(key, ...)
    local r = GetRemote(key)
    if not r then return false end
    if r:IsA("RemoteEvent") then
        r:FireServer(...)
        return true
    elseif r:IsA("RemoteFunction") then
        task.spawn(function(...) pcall(r.InvokeServer, r, ...) end, ...) -- tránh block loop
        return true
    end
    return false
end

