local function isPointer(i, moveType)
    local t = i.UserInputType
    return t == Enum.UserInputType.Touch or t == moveType
end

local dragging, dragStart, startPos = false, nil, nil
title.InputBegan:Connect(function(i)
    if S.Locked or not isPointer(i, Enum.UserInputType.MouseButton1) then return end
    dragging = true
    dragStart = i.Position
    startPos = panel.Position
    i.Changed:Connect(function()
        if i.UserInputState == Enum.UserInputState.End then dragging = false end
    end)
end)

table.insert(conns, UIS.InputChanged:Connect(function(i)
    if not dragging then return end
    if S.Locked then
        dragging = false
        return
    end
    if isPointer(i, Enum.UserInputType.MouseMovement) then
        local d = i.Position - dragStart
        panel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end
end))

env.__MobHubCleanup = function()
    stopESP()
    if S.NV then setNV(false) end
    for _, c in ipairs(conns) do c:Disconnect() end
    hub:Destroy()
    layer:Destroy()
end
