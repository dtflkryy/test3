local function getRoot(model)
    return model.PrimaryPart
        or model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChildWhichIsA("BasePart")
end

local function removeMob(model)
    local m = mobs[model]
    if not m then return end
    if m.conn then m.conn:Disconnect() end
    if m.line then m.line:Destroy() end
    if m.lbl then m.lbl:Destroy() end
    if m.hl then m.hl:Destroy() end
    mobs[model] = nil
end

local function register(hum)
    local model = hum.Parent
    if not model or mobs[model] or not model:IsA("Model") then return end
    if model == LP.Character or Players:GetPlayerFromCharacter(model) then return end
    local m = { hum = hum, model = model }
    m.conn = model.AncestryChanged:Connect(function(_, parent)
        if not parent then removeMob(model) end
    end)
    mobs[model] = m
end

local function ensure(m)
    if m.line then return end
    m.line = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        BorderSizePixel = 0,
        BackgroundTransparency = 0.15,
        Visible = false,
    }, layer)
    m.lbl = new("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(160, 16),
        BackgroundTransparency = 1,
        Font = BOLD,
        TextSize = 13,
        TextStrokeTransparency = 0.4,
        Visible = false,
    }, layer)
    m.hl = new("Highlight", {
        Adornee = m.model,
        FillTransparency = 0.65,
        OutlineTransparency = 0,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
        Enabled = false,
    }, layer)
end

local function hide(m)
    if m.line then
        m.line.Visible = false
        m.lbl.Visible = false
        m.hl.Enabled = false
    end
end

local function gradColor(d)
    return Color3.fromHSV(math.clamp(d / 120, 0, 1) * 0.33, 1, 1)
end

local function update()
    local cam = Workspace.CurrentCamera
    local char = LP.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not cam or not myRoot then
        for _, m in pairs(mobs) do hide(m) end
        barC.Visible = false
        return
    end

    local vp = cam.ViewportSize
    local center = vp / 2
    local bottom = Vector2.new(center.X, vp.Y - 12)
    local half = center - Vector2.new(36, 40)
    local camCF = cam.CFrame
    local myPos = myRoot.Position
    local nearest = math.huge

    for model, m in pairs(mobs) do
        local root = m.root
        if not root or not root.Parent then
            root = getRoot(model)
            m.root = root
        end

        if not root or m.hum.Health <= 0 then
            hide(m)
        else
            local pos3 = root.Position
            local dist = (pos3 - myPos).Magnitude
            if dist > S.Range then
                hide(m)
            else
                ensure(m)
                if dist < nearest then nearest = dist end
                local col = S.AutoColor and gradColor(dist) or S.Color

                local p, vis = cam:WorldToViewportPoint(pos3)
                local target, from
                local behind = false
                if vis then
                    target = Vector2.new(p.X, p.Y)
                    from = (S.Origin == "Bottom") and bottom or center
                else
                    local rel = camCF:PointToObjectSpace(pos3)
                    behind = rel.Z > 0
                    local d = Vector2.new(rel.X, -rel.Y)
                    if d.Magnitude < 1e-3 then d = Vector2.new(0, 1) end
                    d = d.Unit
                    local kx = d.X ~= 0 and half.X / math.abs(d.X) or math.huge
                    local ky = d.Y ~= 0 and half.Y / math.abs(d.Y) or math.huge
                    target = center + d * math.min(kx, ky)
                    from = center
                end

                local line = m.line
                local delta = target - from
                local len = delta.Magnitude
                if S.Tracer and len > 4 then
                    line.Visible = true
                    line.BackgroundColor3 = col
                    line.Size = UDim2.fromOffset(len, 2)
                    line.Position = UDim2.fromOffset((from.X + target.X) / 2, (from.Y + target.Y) / 2)
                    line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
                else
                    line.Visible = false
                end

                local lbl = m.lbl
                if S.Text then
                    lbl.Visible = true
                    lbl.TextColor3 = col
                    lbl.Text = string.format("%s | %dm%s", model.Name, math.floor(dist + 0.5), behind and " | BEHIND" or "")
                    lbl.Position = UDim2.fromOffset(target.X, target.Y - (vis and 20 or 0))
                else
                    lbl.Visible = false
                end

                m.hl.Enabled = S.Chams
                m.hl.FillColor = col
                m.hl.OutlineColor = col
            end
        end
    end

    if S.Bar and nearest < math.huge then
        local col = gradColor(nearest)
        barC.Visible = true
        barFill.Size = UDim2.new(math.clamp(1 - nearest / 100, 0, 1), 0, 1, 0)
        barFill.BackgroundColor3 = col
        barText.TextColor3 = col
        barText.Text = "MOB: " .. math.floor(nearest + 0.5) .. "m"
    else
        barC.Visible = false
    end
end

local function startESP()
    if renderConn then return end
    scanId += 1
    local id = scanId
    addConn = Workspace.DescendantAdded:Connect(function(d)
        if d:IsA("Humanoid") then task.defer(register, d) end
    end)
    renderConn = RunService.RenderStepped:Connect(update)
    task.spawn(function()
        local n = 0
        for _, d in ipairs(Workspace:GetDescendants()) do
            if id ~= scanId then return end
            if d:IsA("Humanoid") then register(d) end
            n += 1
            if n % 800 == 0 then task.wait() end
        end
    end)
end

local function stopESP()
    scanId += 1
    if addConn then addConn:Disconnect(); addConn = nil end
    if renderConn then renderConn:Disconnect(); renderConn = nil end
    for model in pairs(mobs) do removeMob(model) end
    barC.Visible = false
end

local function setESP(on)
    S.ESP = on
    if on then startESP() else stopESP() end
end

