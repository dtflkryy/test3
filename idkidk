local function toggleRow(label, key, onChange)
    local b = mkBtn()
    local function r()
        local on = S[key]
        b.Text = label .. ": " .. (on and "ON" or "OFF")
        b.BackgroundColor3 = on and C_ON or C_OFF
    end
    r()
    table.insert(refreshers, r)
    b.Activated:Connect(function()
        local v = not S[key]
        if onChange then onChange(v) else S[key] = v end
        r()
    end)
end

