local NVSet = {
    Brightness = 2,
    Ambient = Color3.fromRGB(200, 255, 200),
    OutdoorAmbient = Color3.fromRGB(200, 255, 200),
    ClockTime = 14,
    FogEnd = 1e6,
    GlobalShadows = false,
}
local nvSaved, nvConns = {}, {}

local function nvApply(p, v)
    if Lighting[p] ~= v then Lighting[p] = v end
end

local function setNV(on)
    if on and next(nvConns) then return end
    S.NV = on
    local atm = Lighting:FindFirstChildOfClass("Atmosphere")
    if on then
        for p, v in pairs(NVSet) do
            nvSaved[p] = Lighting[p]
            nvApply(p, v)
            nvConns[p] = Lighting:GetPropertyChangedSignal(p):Connect(function()
                if S.NV then nvApply(p, v) end
            end)
        end
        if atm then
            nvSaved.Density = atm.Density
            atm.Density = 0
        end
    else
        for p, c in pairs(nvConns) do
            c:Disconnect()
            nvConns[p] = nil
        end
        for p in pairs(NVSet) do
            if nvSaved[p] ~= nil then Lighting[p] = nvSaved[p] end
        end
        if atm and nvSaved.Density then atm.Density = nvSaved.Density end
    end
end

