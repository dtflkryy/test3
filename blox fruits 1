local function GetCurrentQuestData()
    local level = GetLevel()
    local best = nil
    for _, q in ipairs(QuestData) do
        if level >= q.MinLevel and (not best or q.MinLevel > best.MinLevel) then
            best = q
        end
    end
    return best
end

