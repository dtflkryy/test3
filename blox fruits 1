-- 5. HÀM TIỆN ÍCH NHÂN VẬT
-- ===================================================================
local function GetChar()
    return Player.Character
end

local function GetRoot()
    local char = GetChar()
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid()
    local char = GetChar()
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function IsAlive(model)
    local hum = model and model:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0 and model:FindFirstChild("HumanoidRootPart")
end

-- ===================================================================
-- 6. NOCLIP
-- ===================================================================
local NoclipEnabled = false
local NoclipConn

local function SetNoclip(state)
    NoclipEnabled = state
    if state and not NoclipConn then
        NoclipConn = RunService.Stepped:Connect(function()
            local char = GetChar()
            if not char then return end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end)
    elseif not state and NoclipConn then
        NoclipConn:Disconnect()
        NoclipConn = nil
    end
end

-- ===================================================================
-- 7. TWEEN TO (DI CHUYỂN MƯỢT + NOCLIP)
-- ===================================================================
local CurrentTween

local function CancelTween()
    if CurrentTween then
        CurrentTween:Cancel()
        CurrentTween = nil
    end
end

local function TweenTo(TargetCFrame)
    local root = GetRoot()
    if not root then return end

    local distance = (root.Position - TargetCFrame.Position).Magnitude
    if distance < 5 then
        root.CFrame = TargetCFrame
        return
    end

    CancelTween()
    SetNoclip(true)

    local time = distance / math.max(Config.TweenSpeed, 50)
    CurrentTween = TweenService:Create(root, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = TargetCFrame})
    CurrentTween:Play()

    local tween = CurrentTween
    local finished = false
    tween.Completed:Connect(function() finished = true end)

    -- Chờ tween xong (có thể bị hủy giữa chừng khi tắt farm)
    while not finished and Config.Running and tween == CurrentTween do
        task.wait(0.05)
    end

    if tween == CurrentTween then
        CurrentTween = nil
    end
    if not Config.AutoFarm then
        SetNoclip(false)
    end
end

-- ===================================================================
-- 8. AUTO EQUIP
-- ===================================================================
local function AutoEquip()
    local char = GetChar()
    local hum = GetHumanoid()
    if not char or not hum then return end

    -- Đã cầm đúng loại vũ khí?
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.ToolTip == Config.SelectWeapon then
            return tool
        end
    end

    local backpack = Player:FindFirstChild("Backpack")
    if not backpack then return end
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and tool.ToolTip == Config.SelectWeapon then
            hum:EquipTool(tool)
            return tool
        end
    end
end

-- ===================================================================
-- 9. BRING MOBS
-- ===================================================================
local function BringMobs(TargetName, Range, GatherPoint)
    local root = GetRoot()
    if not root then return end

    local point = GatherPoint or (root.CFrame * CFrame.new(0, 0, -8))

    pcall(function()
        if sethiddenproperty then
            sethiddenproperty(Player, "SimulationRadius", math.huge)
        end
    end)

    for _, mob in ipairs(EnemiesFolder:GetChildren()) do
        if mob.Name == TargetName and IsAlive(mob) then
            local mobRoot = mob.HumanoidRootPart
            if (mobRoot.Position - root.Position).Magnitude <= Range then
                mobRoot.CFrame = point
                mobRoot.CanCollide = false
                mobRoot.Size = Vector3.new(50, 50, 50)
                local hum = mob:FindFirstChildOfClass("Humanoid")
                if hum then hum.WalkSpeed = 0 end
            end
        end
    end
end

-- ===================================================================
-- 10. FAST ATTACK
-- ===================================================================
local function FastAttackStep()
    local char = GetChar()
    local root = GetRoot()
    if not char or not root then return end

    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end

    -- Cách 1: dùng Remote tùy chỉnh (nếu bạn điền ở phần 3)
    if Remotes.Attack and Remotes.Hit then
        local targets = {}
        for _, mob in ipairs(EnemiesFolder:GetChildren()) do
            if IsAlive(mob) and (mob.HumanoidRootPart.Position - root.Position).Magnitude <= 60 then
                table.insert(targets, mob.HumanoidRootPart)
            end
        end
        if #targets > 0 then
            pcall(function()
                Remotes.Attack:FireServer(0.1)
                Remotes.Hit:FireServer(targets[1], targets) -- [PLACEHOLDER] chỉnh tham số theo game
            end)
        end
        return
    end

    -- Cách 2: dự phòng, click mô phỏng
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(1280, 672))
        VirtualUser:Button1Up(Vector2.new(1280, 672))
    end)
end

-- ===================================================================
-- 11. QUEST SYSTEM + FARM LOGIC
-- ===================================================================
local function AcceptQuest(data)
    if not Remotes.Comm then return end
    pcall(function()
        Remotes.Comm:InvokeServer(RemoteNames.StartQuest, data.QuestName, data.QuestIndex)
    end)
end

local function FarmStep()
    local data = GetCurrentQuestData()
    local root = GetRoot()
    if not data or not root then return end

    -- Bước 1: nhận nhiệm vụ
    if Config.AutoQuest and not HasQuest() then
        TweenTo(data.NPCCFrame)
        if not Config.AutoFarm then return end
        task.wait(0.3)
        AcceptQuest(data)
        task.wait(0.5)
    end

    -- Bước 2: trang bị vũ khí
    if Config.AutoEquip then
        AutoEquip()
    end

    -- Bước 3: bay tới bãi quái, đứng cao phía trên
    local hoverCF = data.MobCFrame * CFrame.new(0, Config.FarmHeight, 0)
    hoverCF = CFrame.new(hoverCF.Position, data.MobCFrame.Position) -- nhìn xuống

    if (root.Position - hoverCF.Position).Magnitude > 15 then
        TweenTo(hoverCF)
    else
        root.CFrame = hoverCF
        root.Velocity = Vector3.zero
    end

    -- Bước 4: gom quái về điểm cố định dưới chân
    if Config.BringMobs then
        BringMobs(data.MobName, Config.BringRange, data.MobCFrame)
    end
end

-- ===================================================================
-- 12. AUTO STATS
-- ===================================================================
local function AutoStatsStep()
    if not Remotes.Comm then return end
    local points = GetPoints()
    if points <= 0 then return end
    local amount = math.min(Config.PointsPerTick, points)
    pcall(function()
        Remotes.Comm:InvokeServer(RemoteNames.AddPoint, Config.StatToAdd, amount)
    end)
end

